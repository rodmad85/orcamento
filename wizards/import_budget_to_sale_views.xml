<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_import_budget_to_sale_form" model="ir.ui.view">
        <field name="name">wizard.import.budget.to.sale.form</field>
        <field name="model">wizard.import.budget.to.sale</field>
        <field name="arch" type="xml">
            <form string="Importar Orçamento">
                <field name="sale_order_id" invisible="1"/>
                <div class="oe_inline" style="width: 100%%;">
                    <field name="line_ids" nolabel="1">
                        <tree limit="100">
                            <field name="select" invisible="1"/>
                            <button name="action_toggle_select" type="object"
                                    string=" " icon="fa-check-square-o"
                                    attrs="{'invisible': [('select', '=', False)]}"/>
                            <button name="action_toggle_select" type="object"
                                    string=" " icon="fa-square-o"
                                    attrs="{'invisible': [('select', '=', True)]}"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="meio"/>
                            <field name="client_number"/>
                            <field name="date_order"/>
                            <field name="total_materiais" widget="monetary" optional="show"/>
                            <field name="custo_horas_total" widget="monetary" optional="show"/>
                            <field name="total_horas" optional="show"/>
                            <field name="total_terceiros" widget="monetary" optional="show"/>
                            <field name="total_geral" widget="monetary"/>
                        </tree>
                    </field>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_budget_to_sale" model="ir.actions.act_window">
        <field name="name">Importar Orçamento</field>
        <field name="res_model">wizard.import.budget.to.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
