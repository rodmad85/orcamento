<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences for ordem de servico -->
       <record id="orca_sequence" model="ir.sequence">
            <field name="name">Orçamento</field>
            <field name="code">orca.seq</field>
            <field name="prefix">ORC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="orca_budget_sequence" model="ir.sequence">
            <field name="name">Orçamento (Listagem)</field>
            <field name="code">orca.budget.seq</field>
            <field name="prefix">BGT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="orca_purchase_list_sequence" model="ir.sequence">
            <field name="name">Lista de Compras</field>
            <field name="code">orca.purchase.list.seq</field>
            <field name="prefix">COMP-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
